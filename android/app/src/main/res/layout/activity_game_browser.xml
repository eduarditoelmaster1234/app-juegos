<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gb_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/gb_toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/gb_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/gb_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver"
                android:padding="10dp"
                android:src="@drawable/ic_gb_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/gb_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="GANAMOS"
                    android:textColor="@color/gb_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/gb_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/gb_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/gb_reload"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Recargar plataforma"
                android:padding="11dp"
                android:src="@drawable/ic_gb_refresh" />

            <ImageButton
                android:id="@+id/gb_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cerrar juego"
                android:padding="11dp"
                android:src="@drawable/ic_gb_close" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gb_border" />

        <ProgressBar
            android:id="@+id/gb_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/gb_border"
            android:progressTint="@color/gb_accent" />

        <FrameLayout
            android:id="@+id/gb_web_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/gb_background">

            <LinearLayout
                android:id="@+id/gb_loading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/gb_background"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ProgressBar
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/gb_accent" />

                <TextView
                    android:id="@+id/gb_loading_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="Cargando plataforma..."
                    android:textColor="@color/gb_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gb_loading_domain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:textColor="@color/gb_text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="La plataforma se abre dentro de GANAMOS"
                    android:textColor="#7C6BA8"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/gb_error"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/gb_background"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Error de carga"
                    android:src="@drawable/ic_gb_error" />

                <TextView
                    android:id="@+id/gb_error_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="No se pudo cargar la plataforma"
                    android:textColor="@color/gb_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gb_error_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/gb_text_muted"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/gb_retry"
                    android:layout_width="200dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="22dp"
                    android:backgroundTint="@color/gb_accent"
                    android:text="Reintentar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/gb_error_close"
                    android:layout_width="200dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="Volver a GANAMOS"
                    android:textAllCaps="false"
                    android:textColor="@color/gb_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
